{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["src/**"],
      "outputs": ["dist/**", ".next/**"]
    },
    "schema:gen": {
      "inputs": ["../../schemas/**/*.json"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["build"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig.json", "biome.jsonc"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "test/**",
        "jest.config.js",
        "vitest.config.ts",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "format": {
      "inputs": [
        "biome.jsonc"
      ]
    }
  }
}

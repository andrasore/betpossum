{
  "realm": "betting",
  "enabled": true,
  "displayName": "BetPossum",
  "displayNameHtml": "BetPossum",
  "loginTheme": "betpossum",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "__SSL_REQUIRED__",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator — access to admin pages"
      },
      { "name": "user", "description": "Regular user" }
    ]
  },
  "defaultRole": {
    "name": "default-roles-betting",
    "composite": true,
    "composites": {
      "realm": ["user"],
      "client": {
        "account": ["view-profile", "manage-account"]
      }
    }
  },
  "clients": [
    {
      "clientId": "betting-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "__PUBLIC_ORIGIN__/auth/callback",
        "__PUBLIC_ORIGIN__/auth/silent"
      ],
      "webOrigins": ["__PUBLIC_ORIGIN__"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__PUBLIC_ORIGIN__/*"
      }
    },
    {
      "clientId": "betting-core",
      "enabled": true,
      "publicClient": false,
      "secret": "__CORE_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": []
    }
  ],
  "users": [
    {
      "username": "service-account-betting-core",
      "enabled": true,
      "serviceAccountClientId": "betting-core",
      "clientRoles": {
        "realm-management": ["view-users", "query-users"]
      }
    },
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "bob",
      "email": "admin@example.com",
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["admin", "user"]
    }
  ]
}

{
  "name": "@betting/notifications",
  "version": "0.1.0",
  "scripts": {
    "schema:gen": "mkdir -p ./src/generated && node ../../tools/gen-zod.mjs ../../schemas/json ./src/generated/events.ts",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "pnpx @biomejs/biome check",
    "lint:fix": "pnpx @biomejs/biome check --write --unsafe"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/websockets": "^11.1.19",
    "amqplib": "^0.10.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.6.0",
    "jest": "^30.4.2",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
